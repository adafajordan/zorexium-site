# ── MongoDB ────────────────────────────────────────────────────────────────────
# Required: your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zorexium?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────────────────────
# Required: generate with: openssl rand -hex 64
# NEVER use the default – it is public and allows token forgery
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars

# ── Node Environment ───────────────────────────────────────────────────────────
# Required in production to enable SameSite=None cookies, Secure flag,
# and suppress the devResetToken leak in password-reset responses.
NODE_ENV=production

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
BASE_URL=https://zorexium-backend.onrender.com

# ── CORS ───────────────────────────────────────────────────────────────────────
# Optional: comma-separated extra origins (e.g. staging domain).
# zorexium.io and www.zorexium.io are always allowed.
# Add https://adafajordan.github.io if you use the raw GitHub Pages URL.
CORS_ORIGINS=

# ── PayPal ─────────────────────────────────────────────────────────────────────
# Get these from https://developer.paypal.com/ → My Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
# Use 'sandbox' for testing, 'live' for production
PAYPAL_MODE=sandbox
# Optional: existing recurring Pro Seller plan ID that matches PAYPAL_MODE
PAYPAL_PRO_SELLER_PLAN_ID=
# Required if you enable /api/paypal/webhook verification in production
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# ── Email / SMTP (for password reset and OTC login) ────────────────────────────
# Configure these to enable real email delivery via Nodemailer.
# Without them, password reset and one-time-code login will be logged to
# the console (development only – not suitable for production).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM=Zorexium <noreply@example.com>
