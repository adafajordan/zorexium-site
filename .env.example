# ── MongoDB ────────────────────────────────────────────────────────────────────
# Required: your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zorexium?retryWrites=true&w=majority

# ── JWT ────────────────────────────────────────────────────────────────────────
# Required: generate with: openssl rand -hex 64
# NEVER use the default – it is public and allows token forgery
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars

# ── Node Environment ───────────────────────────────────────────────────────────
# Required in production to enable SameSite=None cookies, Secure flag,
# and suppress the devResetToken leak in password-reset responses.
NODE_ENV=production

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
# Frontend app URL used for email links and OAuth return redirects
BASE_URL=https://zorexium.io
# Optional explicit frontend URL override used by OAuth redirects
APP_URL=https://zorexium.io
# Optional preferred frontend URL; when set, OAuth redirects prioritize this over APP_URL
FRONTEND_URL=https://zorexium.io
# Public backend URL used for absolute media links
BACKEND_BASE_URL=https://zorexium-backend.onrender.com

# ── CORS ───────────────────────────────────────────────────────────────────────
# Optional: comma-separated extra origins (e.g. staging domain).
# zorexium.io and www.zorexium.io are always allowed.
# Add https://adafajordan.github.io if you use the raw GitHub Pages URL.
CORS_ORIGINS=

# ── Google Sign-In (OAuth/OpenID Connect) ──────────────────────────────────────
# Configure in Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
# Needed only if legacy backend redirect/callback Google OAuth is enabled
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Needed only for legacy backend redirect/callback flow
# Must exactly match the callback URL registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://zorexium-backend.onrender.com/api/auth/google/callback

# ── Stripe (Payments + Connect Express) ───────────────────────────────────────
# Get these from Stripe Dashboard → Developers
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_SELLER_PRICE_ID=price_...
# Optional checkout redirect overrides
STRIPE_SUCCESS_URL=https://zorexium.io/payment-success.html
STRIPE_CANCEL_URL=https://zorexium.io/checkout.html?cancelled=1
# Optional Stripe Connect onboarding redirect overrides
STRIPE_CONNECT_REFRESH_URL=https://zorexium.io/seller-dashboard.html#payouts
STRIPE_CONNECT_RETURN_URL=https://zorexium.io/seller-dashboard.html#payouts

# ── Legacy PayPal (optional compatibility) ────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
PAYPAL_PRO_SELLER_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# ── Email / SMS Notifications ───────────────────────────────────────────────────
# Email delivery is handled through SendGrid.
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@zorexium.io
ADMIN_EMAIL=admin@zorexiumlabs.com
# Optional SMS delivery via Twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=+15551234567
